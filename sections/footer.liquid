<footer class="site-footer">
  <div class="wrap">
    <div>
      <a class="logo" href="/"><i></i>{{ shop.name }}</a>
      <p>{{ section.settings.blurb }}</p>
      {% form 'customer', class: 'newsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="you@email.com" aria-label="Email" required>
        <button class="btn btn-small" type="submit">Join</button>
        {% if form.posted_successfully? %}<p>You're on the list.</p>{% endif %}
      {% endform %}
    </div>
    <div><h4>Shop</h4><ul>{% for c in collections limit: 5 %}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{% endfor %}</ul></div>
    <div><h4>Help</h4><ul>{% for l in linklists.footer.links %}<li><a href="{{ l.url }}">{{ l.title }}</a></li>{% endfor %}</ul></div>
    <p class="legal">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Made in a small garage.</p>
  </div>
</footer>
{% schema %}
{ "name": "Footer", "settings": [ { "type": "textarea", "id": "blurb", "label": "Blurb", "default": "Useful things, honestly priced. Questions? A real person answers." } ] }
{% endschema %}
